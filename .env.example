# All main server settings live here. Apply changes with: docker compose restart

# Minecraft version
VERSION=26.1.2

# RAM for the server (examples: 2G, 4G, 8G)
MEMORY=4G

# Server port (forward/open this port for friends)
PORT=25565

# Message shown in the server list
MOTD=Minecraft 26.1.2 + Fabric

# Difficulty: peaceful, easy, normal, hard
DIFFICULTY=normal

# Game mode: survival, creative, adventure
MODE=survival

MAX_PLAYERS=20

# Render distance (lower = lighter on the server)
VIEW_DISTANCE=10
SIMULATION_DISTANCE=8

# PvP
PVP=true

# FALSE = offline mode: anyone can join with any nickname (cracked clients / TLauncher)
# TRUE = licensed Microsoft/Mojang accounts only
ONLINE_MODE=FALSE

# Whitelist: TRUE - only added players can join (/whitelist add nickname)
ENABLE_WHITELIST=FALSE

# Timezone
TZ=Europe/Moscow
